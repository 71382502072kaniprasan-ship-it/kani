```css
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: #f4f6f9;
  color: #222;
}

button {
  border: none;
  padding: 10px 16px;
  background: #0f62fe;
  color: white;
  border-radius: 5px;
  cursor: pointer;
}

button:hover {
  background: #0353e9;
}

button:disabled {
  background: #999;
  cursor: not-allowed;
}

input,
select,
textarea {
  width: 100%;
  padding: 11px;
  margin: 8px 0;
  border: 1px solid #ccc;
  border-radius: 5px;
  font-size: 14px;
}

textarea {
  min-height: 100px;
  resize: vertical;
}

label {
  display: block;
  margin-top: 10px;
  font-weight: 600;
}

/* Layout */

.app-layout {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  width: 230px;
  min-height: 100vh;
  background: #161616;
  color: white;
  padding: 20px;
}

.sidebar h2 {
  margin-bottom: 30px;
}

.sidebar nav {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.sidebar a {
  color: #ddd;
  text-decoration: none;
  padding: 12px;
  border-radius: 5px;
}

.sidebar a:hover,
.sidebar a.active {
  background: #0f62fe;
  color: white;
}

.main-section {
  flex: 1;
}

.navbar {
  height: 65px;
  background: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 25px;
  border-bottom: 1px solid #ddd;
}

.navbar-right {
  display: flex;
  align-items: center;
  gap: 20px;
}

.content {
  padding: 30px;
}

.content h1 {
  margin-bottom: 25px;
}

.content h2 {
  margin-bottom: 15px;
}

/* Dashboard */

.cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.card {
  background: white;
  padding: 25px;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.card h3 {
  margin-bottom: 15px;
}

.card p {
  font-size: 24px;
  font-weight: bold;
  color: #0f62fe;
}

/* Forms */

.form-container,
.table-container,
.report-container {
  background: white;
  padding: 25px;
  margin-bottom: 25px;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.employee-form {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}

.employee-form button {
  width: 150px;
}

.leave-form {
  max-width: 600px;
}

.actions {
  display: flex;
  gap: 10px;
  margin-top: 10px;
}

/* Tables */

table {
  width: 100%;
  border-collapse: collapse;
  background: white;
  margin-top: 15px;
}

th,
td {
  padding: 14px;
  border-bottom: 1px solid #ddd;
  text-align: left;
}

th {
  background: #161616;
  color: white;
}

tr:hover {
  background: #f5f5f5;
}

/* Login */

.login-container {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #eef1f5;
}

.login-card {
  width: 400px;
  background: white;
  padding: 35px;
  border-radius: 10px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
}

.login-card h1,
.login-card h2 {
  text-align: center;
  margin-bottom: 20px;
}

.login-card button {
  width: 100%;
  margin-top: 10px;
}

.error {
  color: #d32f2f;
  margin-bottom: 10px;
}

.report-container {
  max-width: 600px;
}

.report-container button {
  margin-top: 10px;
}

/* Responsive */

@media (max-width: 900px) {
  .cards {
    grid-template-columns: repeat(2, 1fr);
  }

  .sidebar {
    width: 190px;
  }

  .employee-form {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .app-layout {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    min-height: auto;
  }

  .sidebar nav {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .cards {
    grid-template-columns: 1fr;
  }

  .navbar {
    padding: 0 15px;
  }

  .navbar h2 {
    font-size: 16px;
  }

  .navbar-right span {
    display: none;
  }

  table {
    display: block;
    overflow-x: auto;
  }
}
```
